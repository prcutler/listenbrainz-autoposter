# Copy to .env and fill in. Leave a platform's values blank to skip it.
LISTENBRAINZ_USERNAME=

# Bluesky (optional) — use an App Password, not your real password
BSKY_USERNAME=
BSKY_PASSWORD=

# Mastodon (optional) — token needs write:statuses and write:media
MASTODON_INSTANCE=
MASTODON_TOKEN=

# Optional: TEXT_ONLY=1 posts text without the image
TEXT_ONLY=
